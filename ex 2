import Pyro4


@Pyro4.expose
class Calculator:

    def add_numbers(self, a, b):
        return a + b

    def multiply_numbers(self, a, b):
        return a * b


# Create Pyro4 daemon
daemon = Pyro4.Daemon()

# Register Calculator object
uri = daemon.register(Calculator())

print("Calculator server is running...")
print("Server URI:", uri)

# Start server
daemon.requestLoop()


import Pyro4


# Get URI from user
uri = input("Enter the Server URI: ")

# Connect to remote object
calculator = Pyro4.Proxy(uri)

# Get numbers
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))

# Call remote methods
addition = calculator.add_numbers(a, b)
multiplication = calculator.multiply_numbers(a, b)

# Display results
print("Addition:", addition)
print("Multiplication:", multiplication)
